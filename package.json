{
  "name": "falcon-browser",
  "productName": "Falcon",
  "version": "2.7.0",
  "description": "A fast, focused Chromium browser built for gamers.",
  "main": "src/main.js",
  "author": "Calvin Bandle",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:all": "electron-builder -wml",
    "release": "electron-builder --win --publish always",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.falcon.browser",
    "productName": "Falcon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/falcon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Falcon",
      "installerIcon": "assets/falcon.ico",
      "uninstallerIcon": "assets/falcon.ico",
      "artifactName": "Falcon-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "assets/falcon.png",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Falcon-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Websites wie Discord können die Kamera nutzen.",
        "NSMicrophoneUsageDescription": "Websites wie Discord können das Mikrofon nutzen."
      }
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Falcon-${version}-linux-${arch}.${ext}",
      "category": "Network;WebBrowser",
      "executableName": "falcon",
      "synopsis": "Der schnelle Browser für Gamer",
      "maintainer": "Falcon <noreply@falconbrowser.de>",
      "mimeTypes": [
        "text/html"
      ],
      "desktop": {
        "Name": "Falcon",
        "GenericName": "Web Browser",
        "GenericName[de]": "Webbrowser",
        "Comment[de]": "Der schnelle Browser für Gamer",
        "Keywords": "browser;web;internet;gaming;",
        "StartupWMClass": "Falcon"
      },
      "publish": [
        {
          "provider": "github",
          "releaseType": "release",
          "publishAutoUpdate": false
        }
      ],
      "description": "The fast browser built for gamers – Game Mode, ad blocker, split view, free games and deals."
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "name": "HTML-Dokument",
        "role": "Viewer"
      }
    ],
    "dmg": {
      "title": "Falcon ${version}${arch}",
      "artifactName": "Falcon-${version}-mac-${arch}.${ext}"
    },
    "deb": {
      "packageName": "falcon-browser",
      "fpm": [
        "build/linux/falcon.metainfo.xml=/usr/share/metainfo/de.falconbrowser.Falcon.metainfo.xml"
      ]
    },
    "rpm": {
      "packageName": "falcon-browser",
      "fpm": [
        "--debug",
        "build/linux/falcon.metainfo.xml=/usr/share/metainfo/de.falconbrowser.Falcon.metainfo.xml"
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.7",
    "tldts": "^7.4.19"
  },
  "repository": "github:calvinistkrass/Falcon",
  "homepage": "https://falconbrowser.de"
}
