<component type="desktop-application">
  <id>de.falconbrowser.Falcon</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Falcon</name>
  <summary>The fast browser built for gamers</summary>
  <summary xml:lang="de">Der schnelle Browser für Gamer</summary>
  <developer id="de.falconbrowser">
    <name>Falcon</name>
  </developer>
  <description>
    <p>Falcon is a fast, focused Chromium browser built for gamers. It stays light while you play and brings the things gamers need right into the browser.</p>
    <p xml:lang="de">Falcon ist ein schneller, schlanker Chromium-Browser für Gamer. Er bleibt leicht, während du spielst, und bringt alles, was Gamer brauchen, direkt in den Browser.</p>
    <ul>
      <li>Game Mode and a live performance monitor for CPU and memory</li>
      <li xml:lang="de">Game Mode und Leistungsanzeige für CPU und Arbeitsspeicher</li>
      <li>Built-in ad blocker</li>
      <li xml:lang="de">Eingebauter Werbeblocker</li>
      <li>Split view, command palette (Ctrl+K) and tab preview</li>
      <li xml:lang="de">Geteilte Ansicht, Befehlspalette (Strg+K) und Tab-Vorschau</li>
      <li>Free games and deals from Steam, Epic and GOG</li>
      <li xml:lang="de">Gratis-Spiele und Angebote von Steam, Epic und GOG</li>
      <li>Password manager and passkeys</li>
      <li xml:lang="de">Passwort-Manager und Passkeys</li>
      <li>Falcon account with end-to-end encrypted sync, FalCoins, daily rewards and missions</li>
      <li xml:lang="de">Falcon-Konto mit Ende-zu-Ende-verschlüsseltem Sync, FalCoins, täglicher Belohnung und Missionen</li>
    </ul>
  </description>
  <launchable type="desktop-id">falcon.desktop</launchable>
  <icon type="stock">falcon</icon>
